#!/bin/sh
# Локальные проверки и план пакетов CI; ошибки блокируют push.
set -eu
: "${CARGO_BUILD_JOBS:=2}" "${CARGO_PROFILE_DEV_DEBUG:=0}" "${CARGO_PROFILE_TEST_DEBUG:=0}"
export CARGO_BUILD_JOBS CARGO_PROFILE_DEV_DEBUG CARGO_PROFILE_TEST_DEBUG
run() {
    if [ "${TEST_AFFECTED_DRY:-0}" = 1 ]; then echo "dry-run: $*"; else "$@"; fi
}
zero=0000000000000000000000000000000000000000
base=""
head=""
new=0
updates=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" != "$zero" ] || continue
    updates=$((updates + 1))
    commit=$(git rev-parse --verify "$local_sha^{commit}")
    [ -z "$head" ] || [ "$head" = "$commit" ] || { echo 'pre-push: multiple commits' >&2; exit 1; }
    head=$commit
    if [ "$remote_sha" = "$zero" ]; then
        new=1
    else
        [ -z "$base" ] || [ "$base" = "$remote_sha" ] || { echo 'pre-push: multiple bases' >&2; exit 1; }
        base=$remote_sha
    fi
done
[ "$updates" -gt 0 ] || exit 0
[ "$head" = "$(git rev-parse --verify 'HEAD^{commit}')" ] || { echo 'pre-push: checkout differs from pushed commit' >&2; exit 1; }
run cargo fmt --all -- --check
run sh scripts/check-dir-entries.sh
run sh scripts/check-line-limit.sh
if [ "${FULL:-0}" = 1 ]; then
    sh scripts/testing/test-affected.sh --full --mode run --kind all
else
    if [ "$new" = 1 ]; then
        [ -z "$base" ] || { echo 'pre-push: mixed new and existing refs' >&2; exit 1; }
        base=$(git merge-base HEAD origin/main) || { echo 'pre-push: no base' >&2; exit 1; }
    fi
    [ -n "$base" ] || { echo 'pre-push: no base' >&2; exit 1; }
    sh scripts/testing/test-affected.sh --base "$base" --mode run --kind all
fi
if [ "${TEST_AFFECTED_DRY:-0}" != 1 ]; then cargo sweep --time 7 2>/dev/null || true; fi
