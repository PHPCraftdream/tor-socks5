From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tor-socks5 maintainers <noreply@users.noreply.github.com>
Date: Wed, 11 Nov 2026 00:00:00 +0000
Subject: [PATCH] tor-dirclient: use an idle body-read timeout

Reset the body-read timeout after each successful read, while retaining
the existing independent header timeout. Add regressions for idle timeout,
progressing reads, and the header timeout.

diff --git a/src/lib.rs b/src/lib.rs
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -468,17 +468,16 @@
 {
     let buffer_window_size = 1024;
     let mut written_total: usize = 0;
-    // TODO(nickm): This should be an option, and is maybe too long.
-    // Though for some users it may be too short?
-    let read_timeout = Duration::from_secs(10);
-    let timer = runtime.sleep(read_timeout).fuse();
-    futures::pin_mut!(timer);
+    let idle_timeout = Duration::from_secs(90);
 
     loop {
         // allocate buffer for next read
         result.resize(written_total + buffer_window_size, 0);
         let buf: &mut [u8] = &mut result[written_total..written_total + buffer_window_size];
 
+        // Cancellation ends this response; never resume a timed-out decoder.
+        let timer = runtime.sleep(idle_timeout).fuse();
+        futures::pin_mut!(timer);
         let status = futures::select! {
             status = stream.read(buf).fuse() => status,
             _ = timer => {
@@ -593,6 +592,9 @@
         (Some(other), _) => Err(RequestError::ContentEncoding(other.into())),
     }
 }
+
+#[cfg(test)]
+mod local_test;
 
 #[cfg(test)]
 mod test {
diff --git a/src/local_test.rs b/src/local_test.rs
new file mode 100644
--- /dev/null
+++ b/src/local_test.rs
@@ -0,0 +1,64 @@
+use super::*;
+use tor_rtmock::{MockRuntime, io::stream_pair};
+
+/// Progress resets the deadline even beyond the old total budget.
+#[test]
+fn body_progress_resets_idle_timeout() {
+    MockRuntime::test_with_various(|rt| async move {
+        let (reader, mut writer) = stream_pair();
+        let mut output = Vec::new();
+        {
+            let read = read_and_decompress(&rt, reader, 100, &mut output);
+            futures::pin_mut!(read);
+            assert!(futures::poll!(&mut read).is_pending());
+            for byte in b"abc" {
+                rt.advance_by(Duration::from_secs(60)).await;
+                assert!(futures::poll!(&mut read).is_pending());
+                writer.write_all(&[*byte]).await.expect("write body byte");
+                assert!(futures::poll!(&mut read).is_pending());
+            }
+            writer.close().await.expect("close body");
+            read.await.expect("progressing body completes");
+        }
+        assert_eq!(output, b"abc");
+    });
+}
+
+/// A stall survives 89 seconds and fails after the 90-second bound.
+#[test]
+fn body_idle_timeout() {
+    MockRuntime::test_with_various(|rt| async move {
+        let (reader, _held_open) = stream_pair();
+        let mut output = Vec::new();
+        {
+            let read = read_and_decompress(&rt, reader, 100, &mut output);
+            futures::pin_mut!(read);
+            assert!(futures::poll!(&mut read).is_pending());
+            rt.advance_by(Duration::from_secs(89)).await;
+            assert!(futures::poll!(&mut read).is_pending());
+            rt.advance_by(Duration::from_secs(2)).await;
+            assert!(matches!(read.await, Err(RequestError::DirTimeout)));
+        }
+        assert!(output.is_empty());
+    });
+}
+
+/// Header stalls retain their independent ten-second total timeout.
+#[test]
+fn stalled_headers_timeout_independently() {
+    MockRuntime::test_with_various(|rt| async move {
+        let (reader, mut writer) = stream_pair();
+        let mut reader = BufReader::new(reader);
+        let read = read_headers(&rt, &mut reader);
+        futures::pin_mut!(read);
+        assert!(futures::poll!(&mut read).is_pending());
+        rt.advance_by(Duration::from_secs(6)).await;
+        writer
+            .write_all(b"HTTP/1.0 200 OK\r\n")
+            .await
+            .expect("partial headers");
+        assert!(futures::poll!(&mut read).is_pending());
+        rt.advance_by(Duration::from_secs(5)).await;
+        assert!(matches!(read.await, Err(RequestError::DirTimeout)));
+    });
+}
