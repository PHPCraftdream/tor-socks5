## tor-socks5 configuration template.
## Copy this file to tor-socks5.ktav and edit.
## Real bridges, a custom listen address, and runtime state belong in
## tor-socks5.ktav which is gitignored.
##
## Ktav 0.6 syntax: only ## at the start of a line is a comment.
## A single # is content. No inline or trailing comments.
## Everything after the colon is value verbatim until end of line.

## Listen addresses — one SOCKS5 + HTTP CONNECT listener per address.
## Accepts a scalar or list; each value accepts host1,host2:port shorthand,
## e.g. listen: 127.0.0.1,[::1]:1080 (IPv6 must be bracketed).
## Expand/deduplicate keeping the first occurrence; writeback uses a list.
## AddrInUse, PermissionDenied and AddrNotAvailable are skipped with
## WARN and a reason. At least one bound listener serves; all failing
## is an error. Other bind errors remain hard failures.
## Occupied ports are never taken over. No automatic retry is implemented
## (LST-05), including for in-use or permission-denied addresses.
listen: [
    127.0.0.1:1080
]

log.default: info
log.output: stderr
log.ansi: true

bridges.lines: [
    obfs4 198.51.100.7:9001 0000000000000000000000000000000000AAAAAA cert=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA iat-mode=0
    webtunnel [2001:db8::1]:443 0000000000000000000000000000000000BBBBBB url=https://example.com/path ver=0.0.3
]

## WebTunnel first: the three collectors read the same Tor Project distribution
## and test it on their own schedule, together about 150 tested bridges.
bridges.sources: [
    {
        label: scriptzteam-v2-webtunnel-tested
        url: https://raw.githubusercontent.com/scriptzteam/Tor-Bridges-Collector-v2/main/bridges/webtunnel_tested.txt
    }
    {
        label: delta-webtunnel-tested
        url: https://raw.githubusercontent.com/Delta-Kronecker/Tor-Bridges-Collector/main/bridge/webtunnel_tested.txt
    }
    {
        label: onionhop-webtunnel-tested
        url: https://raw.githubusercontent.com/center2055/OnionHop-Bridges-Collector/main/bridge/webtunnel_tested.txt
    }
    {
        label: scriptzteam-v2-obfs4
        url: https://raw.githubusercontent.com/scriptzteam/Tor-Bridges-Collector-v2/main/bridges/obfs4.txt
    }
]

upstream.enabled: false
upstream.address: 127.0.0.1:9050
upstream.username:
upstream.password:

## Local SOCKS5 (RFC 1929) authentication. The CLI auto-detects
## tor-socks5.users.ktav next to this config without either field set;
## these mainly matter for the Android JNI FFI crate. See docs/auth.md.
auth.enabled: true
auth.users_file:

## Destination policy. Onion blocking is enabled by default.
security.block_onion: true

## Background bridge-channel warm-pool (opt-in). Keeps channels to the
## healthiest candidate bridges open ahead of time; does not change which
## bridge carries traffic (that is a separate, not-yet-built feature).
warm_pool.enabled: false
warm_pool.pool_size: 3
warm_pool.refresh_interval_secs: 60

## Optional local DNS server (default OFF): clients send plain UDP/TCP
## DNS queries to dns_server.listen; each is answered via public
## DNS-over-HTTPS providers with every exchange tunnelled through the
## Tor tunnel. Requires the Tor egress (incompatible with upstream.*);
## the cache lands in a .dns-cache file next to this config. Full
## manual: tor-socks5 help dns-server. To enable, uncomment:
## dns_server.listen accepts a scalar/list and host1,host2:port shorthand,
## e.g. 127.0.0.1,[::1]:15353 (IPv6 must be bracketed). Expansion keeps
## the first occurrence of each address; writeback uses the expanded list.
## The skip-unavailable and no-automatic-retry rules above also apply.
## Each address binds an atomic UDP+TCP pair: never serve a half-bound pair.
## At least one complete pair must bind. Local policy and recursion guards
## use only successfully bound endpoints.
## dns_server.enabled: true
## dns_server.listen: [
##     127.0.0.1:15353
## ]
## dns_server.disable_builtin_providers: false
## dns_server.custom_doh_providers: [
##     {
##         ip: 9.9.9.10
##         hostname: dns10.quad9.net
##         path: /dns-query
##     }
## ]
##
## Per-mask resolver overrides: hosts matching a glob mask skip the DoH pool and
## are resolved OUTSIDE the Tor tunnel (plain DNS or the OS resolver) — a
## deliberate, operator-opted exception. Full manual: docs/dns-server.md.
## dns_server.overrides: [
##     {
##         pattern: *.lan
##         resolver: system
##         server: 
##     }
##     {
##         pattern: ns.home.arpa
##         resolver: dns
##         server: 192.168.1.1:53
##     }
## ]
