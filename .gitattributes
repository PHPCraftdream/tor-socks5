# Normalize line endings for the tiered-testing scripts: sh and git hooks
# must stay LF even on Windows checkouts, or `sh`/git fail on CRLF.
*.sh text eol=lf
.githooks/* text eol=lf
*.yml text eol=lf

# Vendored Arti license texts are delivered byte for byte (blob ids are in vendor/PROVENANCE.md).
vendor/*/LICENSE-MIT -text
vendor/*/LICENSE-APACHE -text
